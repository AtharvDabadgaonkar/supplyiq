# Copy to .streamlit/secrets.toml (gitignored) for local use, or paste the
# contents into Streamlit Community Cloud > App settings > Secrets.
#
# Both keys are OPTIONAL. With neither set, SupplyIQ uses the rule-based mock
# agent and shows a "Demo mode: rule-based explanations" badge. Every number in
# the app is computed by the simulator either way.

# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
